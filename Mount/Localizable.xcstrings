    "unexpectedError.header" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unerwarteter Fehler"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur inattendue"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unexpected Error"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发生意外错误"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予期しないエラー"
          }
        }
      }
    },
    "unexpectedError.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Aktivieren des %1$(productName)@ Volumes ist ein unerwarteter Fehler aufgetreten.\n\nStelle sicher, dass du die neueste Version von %1$(productName)@ verwendest.\n\nFalls das Problem weiterhin auftritt, findest du weitere Informationen im Troubleshooting Guide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une erreur inattendue est survenue lors du montage du volume %1$(productName)@.\n\nAssurez-vous d’utiliser la dernière version de %1$(productName)@.\n\nSi le problème persiste, consultez le guide « Troubleshooting »."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An unexpected error occurred while mounting the %1$(productName)@ volume.\n\nPlease make sure you are using the latest version of %1$(productName)@.\n\nIn case the issue persists, refer to the Troubleshooting Guide."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "装载%1$(productName)@宗卷时发生意外错误。\n\n请确保你使用的是最新版本的%1$(productName)@。\n\n如果问题仍然存在，请参阅“Troubleshooting”指南。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ボリュームのマウント中に予期しないエラーが起きました。\n\n最新バージョンの%1$(productName)@を使用していることを確認してください。\n\n問題が解決しない場合は、「Troubleshooting」ガイドを参照してください。"
          }
        }
