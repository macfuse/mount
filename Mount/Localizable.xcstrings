    },
    "installHelperTools.install" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilfsprogramm installieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installer l’utilitaire"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Helper Tool"
          }
        }
      }
    },
    "installHelperTools.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere das Hilfsprogramm, das zum Aktivieren von %1$(productName)@ Volumes erforderlich ist. Gib dazu den Namen und das Passwort eines Administrators ein.\n\nDas Volume wird anschließend automatisch aktiviert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez l’utilitaire requis pour monter les volumes %1$(productName)@. Saisissez le nom et le mot de passe d’un administrateur pour continuer.\n\nUne fois l’utilitaire installé, le volume est monté automatiquement."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the helper tool required to mount %1$(productName)@ volumes. Enter an administrator name and password to continue.\n\nAfter the helper tool is installed, the volume is mounted automatically."
          }
        }
      }
    },
