            "state" : "translated",
            "value" : "Annuler"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel"
          }
        }
      }
    },
    "enableFileSystemExtension.gettingStarted" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getting Started Guide öffnen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir le guide « Getting Started »"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open Getting Started Guide"
          }
        }
      }
    },
    "enableFileSystemExtension.header" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateisystemerweiterung aktivieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer l’extension du système de fichiers"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable File System Extension"
          }
        }
      }
    },
    "enableFileSystemExtension.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die %1$(productName)@ Dateisystemerweiterung.\n\nÖffne Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen. Klicke unter Erweiterungen auf Nach Kategorie. Klicke neben Dateisystemerweiterungen auf das Info-Symbol und aktiviere die %1$(productName)@ Dateisystemerweiterung.\n\nVersuche anschließend erneut, das Volume zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’extension du système de fichiers %1$(productName)@.\n\nOuvrez Réglages Système › Général › Ouverture et extensions. Accédez à Extensions, cliquez sur « Par catégorie », puis cliquez sur le bouton d’informations en regard d’« Extensions du système de fichiers » et activez l’extension du système de fichiers %1$(productName)@.\n\nEssayez ensuite de monter à nouveau le volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable the %1$(productName)@ file system extension.\n\nOpen System Settings › General › Login Items & Extensions. Under Extensions, click By Category. Click the info symbol next to File System Extensions and enable the %1$(productName)@ file system extension.\n\nThen try mounting the volume again."
          }
        }
      }
    },
    "enableFileSystemExtension.systemSettings" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemeinstellungen öffnen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir Réglages Système"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open System Settings"
          }
        }
      }
    },
