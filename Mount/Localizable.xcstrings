    "registerFileSystemExtension.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registriere die %1$(productName)@ Dateisystemerweiterung.\n\nStarte deinen Mac neu und versuche anschließend erneut, das Volume zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez l’extension du système de fichiers %1$(productName)@.\n\nRedémarrez votre Mac, puis essayez de monter à nouveau le volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register the %1$(productName)@ file system extension.\n\nRestart your Mac, then try mounting the volume again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注册%1$(productName)@文件系统扩展。\n\n重新启动Mac，然后再次尝试装载宗卷。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ファイルシステム機能拡張を登録します。\n\nMacを再起動してから、ボリュームをもう一度マウントしてみてください。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra la extensión del sistema de archivos de %1$(productName)@.\n\nReinicia el Mac y, a continuación, vuelve a intentar montar el volumen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ 파일 시스템 확장 프로그램을 등록하십시오.\n\nMac을 재시동한 다음 볼륨을 다시 마운트해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre a extensão do Sistema de Arquivos do %1$(productName)@.\n\nReinicie o Mac e tente montar o volume novamente."
          }
        }
      }
