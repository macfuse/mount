    "registerFileSystemExtension.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registriere die %1$(productName)@ Dateisystemerweiterung.\n\nStarte deinen Mac neu und versuche anschließend erneut, das Volume zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez l’extension du système de fichiers %1$(productName)@.\n\nRedémarrez votre Mac, puis essayez de monter à nouveau le volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register the %1$(productName)@ file system extension.\n\nRestart your Mac, then try mounting the volume again."
          }
        }
      }
    },
