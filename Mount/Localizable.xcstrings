    "installHelperTools.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiere das Hilfsprogramm, das zum Aktivieren von %1$(productName)@ Volumes erforderlich ist. Gib dazu den Namen und das Passwort eines Administrators ein.\n\nDas Volume wird anschließend automatisch aktiviert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez l’utilitaire requis pour monter les volumes %1$(productName)@. Saisissez le nom et le mot de passe d’un administrateur pour continuer.\n\nUne fois l’utilitaire installé, le volume est monté automatiquement."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install the helper tool required to mount %1$(productName)@ volumes. Enter an administrator name and password to continue.\n\nAfter the helper tool is installed, the volume is mounted automatically."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装%1$(productName)@宗卷装载所需的帮助程序工具。输入管理员名称和密码以继续。\n\n帮助程序工具安装完成后，宗卷会自动装载。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ボリュームのマウントに必要なヘルパーツールをインストールします。続けるには、管理者の名前とパスワードを入力してください。\n\nヘルパーツールがインストールされると、ボリュームは自動的にマウントされます。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala la herramienta asociada necesaria para montar los volúmenes de %1$(productName)@. Introduce un nombre y una contraseña de administrador para continuar.\n\nUna vez instalada la herramienta asociada, el volumen se montará automáticamente."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ 볼륨을 마운트하는 데 필요한 보조 프로그램을 설치하십시오. 계속하려면 관리자 이름과 암호를 입력하십시오.\n\n보조 프로그램이 설치되면 볼륨이 자동으로 마운트됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instale a ferramenta auxiliar necessária para montar volumes do %1$(productName)@. Digite o nome e a senha de um administrador para continuar.\n\nApós a instalação da ferramenta auxiliar, o volume será montado automaticamente."
          }
        }
      }
    },
