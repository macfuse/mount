    "enableFileSystemExtension.header" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateisystemerweiterung aktivieren"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer l’extension du système de fichiers"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable File System Extension"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用文件系统扩展"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルシステム機能拡張を有効にする"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar la extensión del sistema de archivos"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일 시스템 확장 프로그램 활성화"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ativar Extensão do Sistema de Arquivos"
          }
        }
      }
    },
    "enableFileSystemExtension.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere die %1$(productName)@ Dateisystemerweiterung.\n\nÖffne Systemeinstellungen › Allgemein › Anmeldeobjekte & Erweiterungen. Klicke unter Erweiterungen auf Nach Kategorie. Klicke neben Dateisystemerweiterungen auf das Info-Symbol und aktiviere die %1$(productName)@ Dateisystemerweiterung.\n\nVersuche anschließend erneut, das Volume zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez l’extension du système de fichiers %1$(productName)@.\n\nOuvrez Réglages Système › Général › Ouverture et extensions. Accédez à Extensions, cliquez sur « Par catégorie », puis cliquez sur le bouton d’informations en regard d’« Extensions du système de fichiers » et activez l’extension du système de fichiers %1$(productName)@.\n\nEssayez ensuite de monter à nouveau le volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable the %1$(productName)@ file system extension.\n\nOpen System Settings › General › Login Items & Extensions. Under Extensions, click By Category. Click the info symbol next to File System Extensions and enable the %1$(productName)@ file system extension.\n\nThen try mounting the volume again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用%1$(productName)@文件系统扩展。\n\n打开“系统设置”›“通用”›“登录项与扩展”。前往“扩展”，点按“按类别”，然后点按“文件系统扩展”旁边的“信息”按钮并启用%1$(productName)@文件系统扩展。\n\n然后再次尝试装载宗卷。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ファイルシステム機能拡張を有効にしてください。\n\nシステム設定で「一般」＞「ログイン項目と機能拡張」を開きます。「機能拡張」で「カテゴリ別」をクリックします。「ファイルシステム機能拡張」の横にある「情報」ボタンをクリックしてから、%1$(productName)@ファイルシステム機能拡張をオンにします。\n\nそのあと、ボリュームをもう一度マウントしてみてください。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa la extensión del sistema de archivos de %1$(productName)@.\n\nAbre Ajustes del Sistema > General > Ítems de inicio y extensiones. En la sección Extensiones, haz clic en “Por categoría”. Haz clic en el botón Información situado junto a “Extensiones del sistema de archivos” y activa la extensión del sistema de archivos de %1$(productName)@.\n\nA continuación, vuelve a intentar montar el volumen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(productName)@ 파일 시스템 확장 프로그램을 활성화하십시오.\n\n시스템 설정 > 일반 > 로그인 항목 및 확장 프로그램을 여십시오. 확장 프로그램으로 이동하여 ‘카테고리별’을 클릭한 다음, ‘파일 시스템 확장 프로그램’ 옆의 정보 버튼을 클릭하고 %1$(productName)@ 파일 시스템 확장 프로그램을 켜십시오.\n\n그런 다음 볼륨을 다시 마운트해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative a extensão do Sistema de Arquivos do %1$(productName)@.\n\nAbra Ajustes do Sistema › Geral › Itens de Início de Sessão e Extensões. Em Extensões, clique em Por Categoria. Clique no botão Informações ao lado de Extensões do Sistema de Arquivos e ative a extensão do Sistema de Arquivos do %1$(productName)@.\n\nEm seguida, tente montar o volume novamente."
          }
        }
      }
    },
