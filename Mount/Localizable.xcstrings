    "creatingMountPointFailed.header" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume konnte nicht aktiviert werden"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume indisponible"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume Not Available"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宗卷不可用"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボリュームを利用できません"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volumen no disponible"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "볼륨을 사용할 수 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volume Indisponível"
          }
        }
      }
    },
    "creatingMountPointFailed.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Volume konnte an folgendem Ort nicht aktiviert werden:\n\n%1$(mountPoint)@\n\nStelle sicher, dass der übergeordnete Ordner vorhanden ist und du die Berechtigung hast, dort Ordner zu erstellen. Versuche anschließend erneut, das Volume zu aktivieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume n’a pas pu être monté à l’emplacement suivant :\n\n%1$(mountPoint)@\n\nAssurez-vous que le dossier parent existe et que vous êtes autorisé à y créer des dossiers. Essayez ensuite de monter à nouveau le volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The volume could not be made available at the following location:\n\n%1$(mountPoint)@\n\nMake sure the enclosing folder exists and that you have permission to create folders there. Then try mounting the volume again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法在以下位置装载宗卷：\n\n%1$(mountPoint)@\n\n请确保上层文件夹存在，并且你有权限在其中创建文件夹。然后再次尝试装载宗卷。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボリュームを次の場所にマウントできませんでした:\n\n%1$(mountPoint)@\n\n内包しているフォルダが存在し、そこにフォルダを作成するためのアクセス権があることを確認してください。そのあと、ボリュームをもう一度マウントしてみてください。"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido montar el volumen en la siguiente ubicación:\n\n%1$(mountPoint)@\n\nAsegúrate de que la carpeta contenedora exista y de que tengas permiso para crear carpetas en ella. A continuación, vuelve a intentar montar el volumen."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음 위치에 볼륨을 마운트할 수 없습니다:\n\n%1$(mountPoint)@\n\n상위 폴더가 존재하고 해당 위치에 폴더를 생성할 권한이 있는지 확인하십시오. 그런 다음 볼륨을 다시 마운트해 보십시오."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível montar o volume no seguinte local:\n\n%1$(mountPoint)@\n\nVerifique se a pasta superior existe e se você tem permissão para criar pastas nela. Em seguida, tente montar o volume novamente."
          }
        }
      }
    },
